# Local development template. Copy to .env and fill in values LOCALLY ONLY.
# .env is gitignored. Never commit real values. In CI these come from GitHub
# Actions secrets and variables, not from a file.

# Organization or user that owns the target repositories (GitHub Actions variable).
TARGET_ORG=

# GitHub App credentials (GitHub Actions secrets).
# GH_APP_PRIVATE_KEY is the PEM contents. Do not store the .pem file in this repo.
GH_APP_ID=
GH_APP_CLIENT_ID=
GH_APP_PRIVATE_KEY=
